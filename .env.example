# Ollama cloud API key — required only for the AI (/enhance/) mapping step.
# Get one at https://ollama.com. The app runs fine without it; AI suggestions
# will just come back empty.
OLLAMA_API_KEY=your_ollama_api_key_here

# Optional overrides
# OLLAMA_HOST=https://ollama.com
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080
